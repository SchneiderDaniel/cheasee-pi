.env

# Generated docker/ tree — canonical source is cmd/cheasee-pi/embedded/docker/
# (required by //go:embed embedded in embed.go). Regenerate with `make docker-tree`;
# CI enforces with `make check-docker`. docker/-only extras (test/, docker-compose.legacy.yml)
# stay tracked.
docker/Dockerfile
docker/docker-compose.yml
docker/entrypoint.sh
docker/run-pi.sh
docker/stop-pi.sh
docker/codeflow/
docker/lib/
.pi/sessions
.pi/supervisor-state.json
.pi/state/session-extensions.json
node_modules
tmp
ignore/
benchmarks/benchmark-results/

# scrapling auto-setup (venv + lock file)
.pi/scrapling-venv/
.pi/.scrapling-venv.lock
.pi/web-search-venv/
.pi/chromium-deps
.pi/crawl4ai-venv
.pi/git/
npm/
custom/
cache/

# Jekyll docs build output
docs/_site/
ignore/

# jscpd duplicate-report artifacts (report/jscpd-report.json) —
# gitignored untracked files never block rebase checkout
/report/

# Unix core dumps (Go crashes during dev)
core
core.*
# But keep TypeScript modules named core.ts (e.g. supervisor pipeline/stages/core.ts)
!core.ts

# Go build artifacts
/cheasee-pi
cmd/cheasee-pi/cheasee-pi
*.exe
*.test

# Python bytecode
__pycache__/
*.pyc

# macOS metadata files
.DS_Store

# Editor/IDE session files
*.swp
*.swo
*.swn
*~
.vim/
.idea/
*.iml
