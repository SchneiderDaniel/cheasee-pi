{
  "defaultModel": "deepseek-v4-flash",
  "defaultProvider": "opencode-go",
  "docker": {
    "memory": "5G",
    "cpus": "4.0"
  },
  "extensions": [
    "rtk",
    "/opt/cheasee-pi/private-pi/extensions/check-extensions"
  ],
  "gitIdentity": {
    "name": "",
    "email": ""
  },
  "packages": [
    "https://github.com/DietrichGebert/ponytail",
    "https://github.com/SchneiderDaniel/private-pi"
  ],
  "prompts": [
    "/opt/cheasee-pi/private-pi/prompts"
  ],
  "sessionDir": ".pi/sessions",
  "skills": [
    ".pi/skills",
    "/opt/cheasee-pi/private-pi/skills"
  ],
  "supervisor": {
    "repo": "SchneiderDaniel/cheasee-pi",
    "projectNumber": 3,
    "statusField": "Status",
    "statusMapping": {
      "Research": "researcher",
      "Architecture": "architect",
      "TestDesign": "test-designer",
      "Implementation": "developer",
      "Audit": "auditor"
    },
    "maxRejections": 3,
    "codeowners": [
      "SchneiderDaniel"
    ],
    "agentTimeoutsMin": {},
    "agentTokenBudget": 300000,
    "bellOnComplete": false,
    "enableExperimentalFeatures": false
  },
  "theme": "cheasee-pi"
}