{
	"contextStatusBar": {
		"showTps": true
	},
	"defaultModel": "deepseek-v4-flash",
	"defaultProvider": "opencode-go",
	"docker": {
		"cpus": "4.0",
		"memory": "5G"
	},
	"extensions": ["rtk", "../private-pi/extensions/check-extensions"],
	"packages": [
		{
			"extensions": [],
			"skills": [],
			"source": "https://github.com/DietrichGebert/ponytail"
		}
	],
	"prompts": [
		"prompts",
		"prompts/operations",
		"prompts/development",
		"prompts/requirement",
		"prompts/misc",
		"../private-pi/prompts"
	],
	"quietStartup": true,
	"sessionDir": ".pi/sessions",
	"skills": [".pi/skills", "../private-pi/skills"],
	"supervisor": {
		"agentTimeoutsMin": {},
		"agentTokenBudget": 300000,
		"bellOnComplete": false,
		"codeowners": ["SchneiderDaniel"],
		"enableExperimentalFeatures": false,
		"maxRejections": 3,
		"projectNumber": 3,
		"repo": "SchneiderDaniel/cheasee-pi",
		"statusField": "Status",
		"statusMapping": {
			"Architecture": "architect",
			"Audit": "auditor",
			"Implementation": "developer",
			"Research": "researcher",
			"TestDesign": "test-designer"
		}
	},
	"theme": "cheasee-pi"
}
