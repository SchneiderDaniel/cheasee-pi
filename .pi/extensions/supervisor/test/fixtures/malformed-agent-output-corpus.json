[
	{
		"raw": "{\"action\":\"COMPLETE\",\"agentName\":\"architect\",\"commentBody\":\"## Architecture\\nMy approach\"}",
		"expectedAction": "COMPLETE",
		"expectedAgentName": "architect",
		"description": "Literal newlines in string values (escaped by jsonrepair then parsed)"
	},
	{
		"raw": "{\"action\":\"COMPLETE\",\"agentName\":\"architect\",\"commentBody\":\"## Architecture\\nWe use the file \"index.ts\" directly\",\"summary\":\"Done\"}",
		"expectedAction": "COMPLETE",
		"expectedAgentName": "architect",
		"description": "Unescaped double-quotes in string values (repaired by jsonrepair)"
	},
	{
		"raw": "---\\n```json\\n{\"action\":\"COMPLETE\",\"agentName\":\"developer\",\"commentBody\":\"## Summary\\nLine two\"}\\n```\\n---",
		"expectedAction": "COMPLETE",
		"expectedAgentName": "developer",
		"description": "Code-fenced JSON with literal newlines in strings"
	},
	{
		"raw": "{\"action\":\"COMPLETE\",\"agentName\":\"developer\",\"commentBody\":\"value: \"key\", is important\"}",
		"expectedAction": null,
		"expectedAgentName": null,
		"expectedError": "FailedParse",
		"description": "Unescaped quote followed by comma — jsonrepair cannot disambiguate from structural close (behavioral regression from #892)"
	}
]
