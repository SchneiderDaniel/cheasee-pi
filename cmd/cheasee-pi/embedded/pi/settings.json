{
  "//": "Generated by cheasee-pi init. Edit this file to configure your pi environment.",
  "defaultProvider": "{{.Provider}}",
  "defaultModel": "gpt-4o",
  "docker": {
    "memory": "{{.Memory}}",
    "cpus": "{{.CPUs}}"
  },
  "gitIdentity": {
    "name": "{{.GitName}}",
    "email": "{{.GitEmail}}"
  },
  "skills": ["/opt/cheasee-pi/.pi/skills"{{if .HasPrivatePi}}, "/opt/cheasee-pi/private-pi/skills"{{end}}],
  "prompts": ["/opt/cheasee-pi/.pi/prompts"{{if .HasPrivatePi}}, "/opt/cheasee-pi/private-pi/prompts"{{end}}],
  "extensions": [{{if .HasPrivatePi}}"/opt/cheasee-pi/private-pi/extensions/check-extensions"{{end}}],
  "theme": "cheasee-pi",
  "sessionDir": ".pi/sessions"
}
